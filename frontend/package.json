{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "generate:api:schema": "cd ../backend && uv run python -m scripts.export_openapi",
    "generate:api:types": "openapi-typescript ../backend/openapi.json -o src/lib/api/generated/schema.d.ts",
    "generate:api": "pnpm run generate:api:schema && pnpm run generate:api:types"
  },
  "dependencies": {
    "next": "16.3.0",
    "openapi-fetch": "^0.17.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
